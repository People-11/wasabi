+
+/// `StandardMemoryAllocator::new_default` with 8 MiB blocks instead of 256 MiB ones, which
+/// are never freed while the allocator lives: the GUI's font texture and vertex buffers
+/// would pin over 500 MB of memory. (Patched in by wasabi's Makefile.)
+fn small_block_memory_allocator(device: &Arc<Device>) -> Arc<StandardMemoryAllocator> {
+    let memory_types = &device.physical_device().memory_properties().memory_types;
+    let unsupported = MemoryPropertyFlags::LAZILY_ALLOCATED
+        | MemoryPropertyFlags::PROTECTED
+        | MemoryPropertyFlags::DEVICE_COHERENT
+        | MemoryPropertyFlags::RDMA_CAPABLE;
+    let memory_type_bits = memory_types
+        .iter()
+        .enumerate()
+        .filter(|(_, t)| !t.property_flags.intersects(unsupported))
+        .fold(0, |bits, (i, _)| bits | 1 << i);
+    Arc::new(StandardMemoryAllocator::new(
+        device.clone(),
+        GenericMemoryAllocatorCreateInfo {
+            block_sizes: &vec![8 << 20; memory_types.len()],
+            memory_type_bits,
+            ..Default::default()
+        },
+    ))
+}
